# ---------------------------------------------------------------------------
# Rezept-App – Konfiguration
#
# Kopieren:  cp .env.example .env   und dann alle "CHANGE_ME"-Werte ersetzen.
# Die .env wird NIE committet (steht in .gitignore).
# Diese Datei wird sowohl von docker compose (Variablen in docker-compose.yml)
# als auch vom Tandoor-Container (env_file) gelesen.
# Alle Optionen: https://docs.tandoor.dev/system/configuration/
# ---------------------------------------------------------------------------

# --- Image -----------------------------------------------------------------
# Feste Version statt "latest", damit Updates bewusst passieren (Backup vorher!).
# Phase 7: hier später unser eigenes Image eintragen, z. B. ghcr.io/nfrankm/recipes:2026.10.1
TANDOOR_IMAGE=vabene1111/recipes:2.6.15

# Port der LXC, auf dem die App lauscht (nginx im Container hört auf 80)
HTTP_PORT=80

# --- Django ----------------------------------------------------------------
# Zufälliger, langer Schlüssel. Erzeugen z. B. mit:
#   openssl rand -base64 48 | tr -d '\n=/+' ; echo
SECRET_KEY=CHANGE_ME

# Zeitzone
TZ=Europe/Berlin

# Hostnamen, unter denen die App aufgerufen wird (kommagetrennt, ohne http://).
# <tailscale-name> = Name der LXC im Tailnet, <tailnet> = z. B. tail1234.ts.net
# Kurzname (MagicDNS), voller Name und Tailscale-IP eintragen:
ALLOWED_HOSTS=rezepte,rezepte.tailXXXX.ts.net,100.x.y.z

# Vollständige Origins (MIT Schema) für den CSRF-Schutz beim Login/Formularen.
# http:// für den direkten Zugriff, https:// wenn "tailscale serve" genutzt wird.
CSRF_TRUSTED_ORIGINS=http://rezepte,http://rezepte.tailXXXX.ts.net,https://rezepte.tailXXXX.ts.net

# Neue Benutzer dürfen sich nicht selbst registrieren (Einladungen über die App)
ENABLE_SIGNUP=0

# Debug NIE in Produktion einschalten
DEBUG=0

# --- PostgreSQL --------------------------------------------------------------
# Werden vom DB-Container (Anlage beim ersten Start) UND von Tandoor verwendet.
# Host/Port/Engine sind in docker-compose.yml fest verdrahtet.
POSTGRES_DB=djangodb
POSTGRES_USER=djangouser
# Langes Zufallspasswort, z. B.: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# --- Optional ----------------------------------------------------------------
# Gunicorn-Worker (für 1–2 Nutzer reichen 2)
GUNICORN_WORKERS=2
# GUNICORN_THREADS=2

# Externe Verbindungen (z. B. KI-Funktionen) global abschalten: 1
# DISABLE_EXTERNAL_CONNECTORS=0

# E-Mail (für Passwort-Reset), nur falls gewünscht
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=
